PORT=4000
DATABASE_URL=postgres://localhost:5432/spider_tracker_dev
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: GitHub OAuth app (callback URL: <API_ORIGIN>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: Batele ID (public PKCE client; callback URL: <API_ORIGIN>/api/auth/callback/batele-id)
BATELE_ID_CLIENT_ID=
# BATELE_ID_ISSUER=https://api-v2.batele.plus/auth
# Optional: who may create accounts (emails and @domains, comma-separated); empty = anyone
SIGNUP_ALLOWLIST=
