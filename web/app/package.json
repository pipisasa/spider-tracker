{
  "name": "@repo/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p functions && vite build",
    "deploy": "bun run build && bunx wrangler@4 pages deploy dist --project-name spider-tracker --branch main",
    "build:staging": "tsc --noEmit && tsc --noEmit -p functions && vite build --mode staging",
    "deploy:staging": "bun run build:staging && bunx wrangler@4 pages deploy dist --project-name spider-tracker --branch staging",
    "preview": "vite preview",
    "preview:pages": "bun run build && bunx wrangler@4 pages dev dist --port 8788",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "bun test"
  },
  "dependencies": {
    "@dicebear/collection": "9.4.3",
