    "@tiptap/suggestion": "3.31.4",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "d3-force": "3.0.0",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.54.0",
