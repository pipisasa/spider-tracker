{
  "name": "spider-tracker",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "backend/*",
    "packages/*",
    "web/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --ui=tui",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:studio": "bun run --cwd packages/db db:studio",
    "spider": "bun backend/cli/src/index.ts",
    "deploy:web": "bun run --cwd web/app deploy",
    "deploy:api": "railway up --service api --detach",
    "claude:channel": "claude --mcp-config .claude/channel.mcp.json --dangerously-load-development-channels server:spider-channel"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "railway": "^3.13.1",
    "turbo": "^2.8.7",
    "typescript": "5.9.2"
  }
}
